#!/usr/bin/env bash
# keel — single-server container deploy tool
# https://github.com/zyx1121/keel

set -euo pipefail

KEEL_STATE_DIR="${KEEL_STATE_DIR:-/var/lib/keel}"
KEEL_CONFIG="${KEEL_CONFIG:-./keel.yaml}"

usage() {
  cat <<EOF
Usage: keel <command> [options]

Commands:
  deploy <image>:<sha>    Pull image, swap container, healthcheck, rollback on failure
  rollback <service>      Re-deploy the previous image for a service
  status <service>        Show current/previous image and last deploy time

Environment:
  KEEL_STATE_DIR   State directory (default: /var/lib/keel)
  KEEL_CONFIG      Path to keel.yaml (default: ./keel.yaml)
EOF
}

# Parse keel.yaml field: keel_yaml_get <file> <key>
keel_yaml_get() {
  local file="$1" key="$2"
  grep -E "^${key}:" "$file" | head -1 | sed 's/^[^:]*:[[:space:]]*//' | tr -d "'\""
}

service_state_dir() {
  local service="$1"
  echo "${KEEL_STATE_DIR}/${service}"
}

cmd_deploy() {
  local image_ref="${1:-}"
  if [[ -z "$image_ref" ]]; then
    echo "error: deploy requires <image>:<tag>" >&2
    exit 1
  fi

  # Load keel.yaml from the service repo (caller cds there first, or KEEL_CONFIG is set)
  local config="${KEEL_CONFIG}"
  if [[ ! -f "$config" ]]; then
    echo "error: keel.yaml not found at $config" >&2
    exit 1
  fi

  local service image health_url health_timeout env_file runtime
  service=$(keel_yaml_get "$config" service)
  image=$(keel_yaml_get "$config" image)
  health_url=$(keel_yaml_get "$config" health_url)
  health_timeout=$(keel_yaml_get "$config" health_timeout)
  health_timeout="${health_timeout:-30}"
  env_file=$(keel_yaml_get "$config" env_file)
  runtime=$(keel_yaml_get "$config" runtime)

  local state_dir
  state_dir=$(service_state_dir "$service")
  mkdir -p "$state_dir"

  echo "[keel] deploying ${image_ref} → service ${service} (runtime: ${runtime})"

  # Step 1: pull image
  echo "[keel] pulling ${image_ref}"
  docker pull "${image_ref}"

  # Step 2: record current for rollback
  local current_file="${state_dir}/current"
  local previous_file="${state_dir}/previous"
  if [[ -f "$current_file" ]]; then
    cp "$current_file" "$previous_file"
    echo "[keel] previous: $(cat "$previous_file")"
  fi

  # Step 3 + 4: stop + start
  _runtime_recreate "$runtime" "$service" "$image_ref" "$env_file" "$config"

  # Step 5: healthcheck
  echo "[keel] healthcheck ${health_url} (timeout: ${health_timeout}s)"
  local elapsed=0
  local ok=0
  while [[ $elapsed -lt $health_timeout ]]; do
    if curl -sf --max-time 3 "$health_url" >/dev/null 2>&1; then
      ok=1
      break
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  if [[ $ok -eq 1 ]]; then
    # Step 6: success
    echo "${image_ref}" > "$current_file"
    echo "[keel] deployed $(cat "$current_file") at $(date -Iseconds)" >> "${state_dir}/deploy.log"
    echo "[keel] deploy success ✓"
  else
    # Step 7: healthcheck failed — rollback
    echo "[keel] healthcheck failed after ${health_timeout}s — rolling back" >&2
    if [[ -f "$previous_file" ]]; then
      local prev_ref
      prev_ref=$(cat "$previous_file")
      echo "[keel] rolling back to ${prev_ref}" >&2
      docker pull "${prev_ref}"
      _runtime_recreate "$runtime" "$service" "$prev_ref" "$env_file" "$config"
      echo "[keel] rollback deployed at $(date -Iseconds)" >> "${state_dir}/deploy.log"
      echo "[keel] rollback deployed ${prev_ref}" >&2
    else
      echo "[keel] no previous image to roll back to" >&2
    fi
    exit 1
  fi
}

cmd_rollback() {
  local service="${1:-}"
  if [[ -z "$service" ]]; then
    echo "error: rollback requires <service>" >&2
    exit 1
  fi

  local state_dir
  state_dir=$(service_state_dir "$service")
  local previous_file="${state_dir}/previous"
  if [[ ! -f "$previous_file" ]]; then
    echo "error: no previous image recorded for service ${service}" >&2
    exit 1
  fi

  local prev_ref
  prev_ref=$(cat "$previous_file")
  echo "[keel] manual rollback: ${service} → ${prev_ref}"

  local config="${KEEL_CONFIG}"
  if [[ ! -f "$config" ]]; then
    echo "error: keel.yaml not found at $config (needed for rollback)" >&2
    exit 1
  fi

  local env_file runtime
  env_file=$(keel_yaml_get "$config" env_file)
  runtime=$(keel_yaml_get "$config" runtime)

  docker pull "${prev_ref}"
  _runtime_recreate "$runtime" "$service" "$prev_ref" "$env_file" "$config"

  local current_file="${state_dir}/current"
  echo "${prev_ref}" > "$current_file"
  echo "[keel] rollback at $(date -Iseconds)" >> "${state_dir}/deploy.log"
  echo "[keel] rollback complete ✓"
}

cmd_status() {
  local service="${1:-}"
  if [[ -z "$service" ]]; then
    echo "error: status requires <service>" >&2
    exit 1
  fi

  local state_dir
  state_dir=$(service_state_dir "$service")

  local current="(none)"
  local previous="(none)"
  if [[ -f "${state_dir}/current" ]]; then
    current=$(cat "${state_dir}/current")
  fi
  if [[ -f "${state_dir}/previous" ]]; then
    previous=$(cat "${state_dir}/previous")
  fi

  echo "service:  ${service}"
  echo "current:  ${current}"
  echo "previous: ${previous}"

  if [[ -f "${state_dir}/deploy.log" ]]; then
    echo "last deploy log:"
    tail -3 "${state_dir}/deploy.log" | sed 's/^/  /'
  fi
}

# _runtime_recreate <runtime> <service> <image_ref> <env_file> <config>
_runtime_recreate() {
  local runtime="$1" service="$2" image_ref="$3" env_file="$4" config="$5"

  case "$runtime" in
    compose)
      _adapter_compose "$service" "$image_ref" "$env_file" "$config"
      ;;
    systemd-container)
      _adapter_systemd "$service" "$image_ref" "$env_file"
      ;;
    *)
      echo "error: unknown runtime '${runtime}' — expected compose or systemd-container" >&2
      exit 1
      ;;
  esac
}

_adapter_compose() {
  local service="$1" image_ref="$2" env_file="$3" config="$4"
  local compose_dir
  compose_dir=$(dirname "$(realpath "$config")")

  echo "[keel] compose: stopping ${service}"
  docker compose -f "${compose_dir}/docker-compose.yml" stop "${service}" 2>/dev/null || true

  # Write the resolved image ref so compose uses the exact SHA
  export IMAGE="${image_ref}"
  echo "[keel] compose: starting ${service} with IMAGE=${image_ref}"
  docker compose -f "${compose_dir}/docker-compose.yml" up -d --pull never "${service}"
}

_adapter_systemd() {
  local service="$1" image_ref="$2" env_file="$3"
  local dropin_dir="/etc/systemd/system/${service}.service.d"

  echo "[keel] systemd: writing image drop-in"
  mkdir -p "$dropin_dir"
  cat > "${dropin_dir}/keel-image.conf" <<EOF
[Service]
Environment=IMAGE=${image_ref}
EOF
  systemctl daemon-reload

  echo "[keel] systemd: restarting ${service}"
  systemctl restart "${service}"
}

# --- main ---

CMD="${1:-}"
shift || true

case "$CMD" in
  deploy)   cmd_deploy   "$@" ;;
  rollback) cmd_rollback "$@" ;;
  status)   cmd_status   "$@" ;;
  help|--help|-h|"") usage ;;
  *)
    echo "error: unknown command '${CMD}'" >&2
    usage >&2
    exit 1
    ;;
esac
