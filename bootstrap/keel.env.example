# /etc/keel/keel.env — runtime secrets for the keel service.
# Copy to /etc/keel/keel.env and fill in real values.
# chmod 600 /etc/keel/keel.env

# PostgreSQL connection string (keel_app role; localhost trust auth, no password —
# see install.sh pg_hba step. Single-tenant spoke-isolated LXC.)
DATABASE_URL=postgres://keel_app@127.0.0.1:5432/keel

# MCP write token — shared secret between keel and Claude
MCP_WRITE_TOKEN=CHANGEME

# GitHub webhook secret (V1 — HMAC-SHA256 of payload)
WEBHOOK_SECRET=CHANGEME

# SSH alias to reach PVE host (must match ~/.ssh/config in this LXC)
PVE_KEEL_SSH_ALIAS=pve-keel
